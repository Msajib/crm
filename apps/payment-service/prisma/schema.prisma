// Payment Service Prisma Schema
// Database: crm_system, Schema: payments

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/payment-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PAYMENT_DATABASE_URL")
}

model PaymentGatewayConfig {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  gateway      String   // STRIPE, PAYPAL, SSLCOMMERZ, BKASH
  publicKey    String   @map("public_key")
  secretKey    String   @map("secret_key")
  settings     Json?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, gateway])
  @@index([tenantId])
  @@map("payment_gateway_configs")
}

model Subscription {
  id           String   @id @default(uuid())
  tenantId     String   @unique @map("tenant_id")
  planId       String   @map("plan_id")
  planName     String   @map("plan_name")
  status       String   @default("ACTIVE") // ACTIVE, TRIAL, EXPIRED, CANCELLED
  startDate    DateTime @default(now()) @map("start_date")
  endDate      DateTime? @map("end_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("subscriptions")
}

model Invoice {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String?  @map("user_id")
  userName    String?  @map("user_name")
  userEmail   String?  @map("user_email")
  orderId     String   @map("order_id")
  planName    String?  @map("plan_name")
  amount      Float
  currency    String   @default("USD")
  status      String   // PENDING, PAID, CANCELLED
  gateway     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("invoices")
}

model PlanPurchaseEvent {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  planId      String   @map("plan_id")
  planName    String   @map("plan_name")
  amount      Float
  purchasedAt DateTime @default(now()) @map("purchased_at")

  @@index([tenantId])
  @@map("plan_purchase_events")
}

model PaymentLink {
  id            String    @id @default(uuid())
  token         String    @unique
  type          String    // SUBSCRIPTION, ONETIME
  planId        String?   @map("plan_id")
  planName      String?   @map("plan_name")
  customPrice   Float?    @map("custom_price")
  currency      String    @default("USD")
  durationDays  Int?      @map("duration_days")
  description   String?   @db.Text
  maxUses       Int       @default(1) @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  affiliateId   String?   @map("affiliate_id")
  commissionPct Float?    @map("commission_pct")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("payment_links")
}

model PaymentLinkUse {
  id        String   @id @default(uuid())
  linkId    String   @map("link_id")
  tenantId  String   @map("tenant_id")
  invoiceId String?  @map("invoice_id")
  usedAt    DateTime @default(now()) @map("used_at")

  @@map("payment_link_uses")
}
