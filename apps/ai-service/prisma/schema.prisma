// AI Service Prisma Schema
// Database: crm_system, Schema: ai

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/ai-client"
}

datasource db {
  provider = "postgresql"
  url      = env("AI_DATABASE_URL")
}

model AIConversation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  messages  Json     @default("[]") // Array of {role: 'user'|'assistant', content: string}
  context   Json     @default("{}") // Relevant metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([userId])
  @@map("ai_conversations")
}

model AIInsight {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  entityId  String   @map("entity_id") // Contact or Deal ID
  type      String   // LEAD_SCORE, DEAL_ANALYSIS, FOLLOW_UP
  content   Json     // The insight data
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([entityId])
  @@map("ai_insights")
}

model Knowledge {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  fileName  String   @map("file_name")
  content   String   // Extracted text
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("knowledge")
}

model AIConfiguration {
  id            String   @id @default(uuid())
  tenantId      String   @unique @map("tenant_id") // Can be "GLOBAL" for platform-wide keys
  provider      String   // OPENAI, GEMINI, ANTHROPIC, GROK
  apiKey        String   @map("api_key")
  modelName     String   @default("gpt-4o") @map("model_name")
  isActive      Boolean  @default(true) @map("is_active")
  settings      Json     @default("{}") // Additional provider-specific settings
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("ai_configurations")
}
