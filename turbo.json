{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "AUTH_DATABASE_URL",
    "TENANT_DATABASE_URL",
    "CRM_DATABASE_URL",
    "COMMUNICATION_DATABASE_URL",
    "MARKETING_DATABASE_URL",
    "PAYMENT_DATABASE_URL",
    "AI_DATABASE_URL",
    "ANALYTICS_DATABASE_URL",
    "RABBITMQ_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:sync": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
