# Environment Variables — Copy to .env in each service

# ─── Infrastructure ───────────────────────────────────────
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_secret_2026
POSTGRES_DB=crm_db
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2026

RABBITMQ_USER=crm_rabbit
RABBITMQ_PASSWORD=rabbit_secret_2026
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── Auth Service ─────────────────────────────────────────
AUTH_SERVICE_PORT=3001
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── API Gateway ──────────────────────────────────────────
API_GATEWAY_PORT=3000

# ─── Tenant Service ───────────────────────────────────────
TENANT_SERVICE_PORT=3002

# ─── CRM Service ──────────────────────────────────────────
CRM_SERVICE_PORT=3003

# ─── Communication Service ────────────────────────────────
COMMUNICATION_SERVICE_PORT=3004
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
SENDGRID_API_KEY=your_sendgrid_api_key

# ─── Marketing Service ────────────────────────────────────
MARKETING_SERVICE_PORT=3005

# ─── Payment Service ──────────────────────────────────────
PAYMENT_SERVICE_PORT=3006

# ─── Analytics Service ────────────────────────────────────
ANALYTICS_SERVICE_PORT=3007

# ─── Admin Panel ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CRM Pro
